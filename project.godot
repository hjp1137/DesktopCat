; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by text files using the basic format.
; Anything after ; is ignored, format is [section] key=value.

config_version=5

[application]

config/name="DesktopCat"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/resizable=true
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
